#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${GEOPANEL_WORKTREE_ENV_FILE:-$ROOT_DIR/.env.dev}"
COMPOSE_FILE="$ROOT_DIR/docker-compose.dev.yml"

usage() {
  cat <<'EOF'
Usage: scripts/dev-worktree [setup|up|down|restart|logs|status|env|reset]

Commands:
  setup    Create .env.dev for this worktree if it does not exist.
  up       Create .env.dev if needed, then start the dev stack.
  down     Stop and remove this worktree's dev stack.
  restart  Restart this worktree's dev stack.
  logs     Follow logs for this worktree's dev stack.
  status   Show containers for this worktree's dev stack.
  env      Print this worktree's generated dev settings.
  reset    Regenerate .env.dev with currently free ports.

Optional:
  GEOPANEL_WORKTREE_ENV_FILE=/path/to/env scripts/dev-worktree up
EOF
}

is_port_free() {
  local port="$1"

  if command -v ss >/dev/null 2>&1; then
    ! ss -ltn | awk '{print $4}' | grep -Eq "[:.]${port}$"
    return
  fi

  if command -v lsof >/dev/null 2>&1; then
    ! lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1
    return
  fi

  if command -v nc >/dev/null 2>&1; then
    ! nc -z 127.0.0.1 "$port" >/dev/null 2>&1
    return
  fi

  return 0
}

next_free_port() {
  local port="$1"
  while ! is_port_free "$port"; do
    port=$((port + 1))
  done
  printf '%s\n' "$port"
}

sanitize() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

project_name() {
  local base hash
  base="$(sanitize "$(basename "$ROOT_DIR")")"
  hash="$(printf '%s' "$ROOT_DIR" | cksum | awk '{print $1}')"
  printf 'geopanel-%s-%s' "${base:-worktree}" "$hash"
}

env_value() {
  local key="$1"
  grep -E "^${key}=" "$ENV_FILE" 2>/dev/null | tail -n 1 | cut -d= -f2-
}

write_env() {
  local project api_port http_port
  project="$(project_name)"
  api_port="$(next_free_port "${GEOPANEL_DEV_API_PORT_START:-18081}")"
  http_port="$(next_free_port "${GEOPANEL_DEV_HTTP_PORT_START:-5173}")"

  cat >"$ENV_FILE" <<EOF
# Generated by scripts/dev-worktree for:
# $ROOT_DIR
COMPOSE_PROJECT_NAME=$project

GEOPANEL_DEV_API_PORT=$api_port
GEOPANEL_DEV_HTTP_PORT=$http_port

GEOPANEL_DATABASE_URL=
GEOPANEL_DATABASE_PASSWORD=
GEOPANEL_DATABASE_ID=preprod-backend
GEOPANEL_DATABASE_NAME=Preprod backend

# Useful when running frontend outside Docker.
VITE_API_PROXY_TARGET=http://127.0.0.1:$api_port
EOF
}

has_required_env() {
  [[ -f "$ENV_FILE" ]] &&
    grep -q '^COMPOSE_PROJECT_NAME=' "$ENV_FILE" &&
    grep -q '^GEOPANEL_DEV_API_PORT=' "$ENV_FILE" &&
    grep -q '^GEOPANEL_DEV_HTTP_PORT=' "$ENV_FILE"
}

ensure_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    write_env
    return
  fi

  if ! has_required_env; then
    local backup
    backup="${ENV_FILE}.backup.$(date +%Y%m%d%H%M%S)"
    mv "$ENV_FILE" "$backup"
    write_env
    printf 'Existing env did not match this dev stack; backed it up to %s\n' "$backup"
  fi
}

compose() {
  docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

stack_has_containers() {
  [[ -n "$(compose ps -q 2>/dev/null || true)" ]]
}

ports_are_free() {
  is_port_free "$(env_value GEOPANEL_DEV_API_PORT)" &&
    is_port_free "$(env_value GEOPANEL_DEV_HTTP_PORT)"
}

ensure_startable_env() {
  ensure_env

  if stack_has_containers; then
    return
  fi

  if ! ports_are_free; then
    local backup
    backup="${ENV_FILE}.backup.$(date +%Y%m%d%H%M%S)"
    mv "$ENV_FILE" "$backup"
    write_env
    printf 'Existing dev ports were busy; backed env up to %s and generated free ports.\n' "$backup"
  fi
}

print_env() {
  ensure_env
  cat "$ENV_FILE"
}

print_urls() {
  local http_port api_port project
  http_port="$(env_value GEOPANEL_DEV_HTTP_PORT)"
  api_port="$(env_value GEOPANEL_DEV_API_PORT)"
  project="$(env_value COMPOSE_PROJECT_NAME)"

  printf 'Project: %s\n' "$project"
  printf 'Web:     http://localhost:%s\n' "$http_port"
  printf 'API:     http://localhost:%s/api/v1/health\n' "$api_port"
}

cmd="${1:-up}"

case "$cmd" in
  setup)
    ensure_env
    print_urls
    ;;
  up)
    ensure_startable_env
    compose up -d --build
    print_urls
    ;;
  down)
    ensure_env
    compose down
    ;;
  restart)
    ensure_startable_env
    compose down
    compose up -d --build
    print_urls
    ;;
  logs)
    ensure_env
    compose logs -f
    ;;
  status)
    ensure_env
    compose ps
    ;;
  env)
    print_env
    ;;
  reset)
    write_env
    print_urls
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
